# Example Configuration File for Future Trailers
#
# This file shows all available environment variables and their defaults.
# Copy this file to .env and customize as needed.
#
# The application will read environment variables from your shell or from a
# .env file if you use a tool like python-dotenv.

# =============================================================================
# COMMON SETTINGS
# =============================================================================

# TMDb API Key (REQUIRED for fetch command)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here

# Logging
LOG_FILE=                        # Optional: Path to log file
LOG_TIMESTAMPS=0                 # Set to 1 to enable timestamps in logs
DEBUG=0                          # Set to 1 to enable debug logging

# =============================================================================
# FETCH COMMAND SETTINGS
# =============================================================================

# Mode: theatrical, streaming, or both
MODE=theatrical

# TMDb region code (ISO 3166-1 alpha-2)
TMDB_REGION=US

# Output directory for downloaded trailers
# Subdirectories will be created: theatrical/ and streaming/
OUT_DIR=/data/trailers

# Date window for fetching trailers
DAYS_AHEAD=365                   # How many days ahead to look for upcoming releases
DAYS_BACK=90                     # How many days back to look for recent releases

# Pagination
MAX_PAGES=10                     # Maximum number of pages to fetch from TMDb

# Video quality
MAX_HEIGHT=1080                  # Maximum video height (e.g., 1080, 720, 480)

# Behavior
DRY_RUN=0                        # Set to 1 to simulate without downloading
SKIP_EXISTING=1                  # Set to 1 to skip folders that already exist

# =============================================================================
# PRUNE COMMAND SETTINGS
# =============================================================================

# Retention policy
RETENTION_YEARS=2                # Keep trailers for this many years after release

# Directories to prune
THEATRICAL_DIR=./theatrical      # Directory for theatrical trailers
STREAMING_DIR=./streaming        # Directory for streaming trailers

# Removed trailers tracking
REMOVED_FILE=./.trailer-removed.txt

# =============================================================================
# FIX-TITLES COMMAND SETTINGS
# =============================================================================

# Root directory to scan for NFO files
# Will scan theatrical/ and streaming/ subdirectories
ROOT_DIR=/data/trailers

# Title prefix to add (if not already present)
PREFIX=Trailer - 

# =============================================================================
# DAEMON COMMAND SETTINGS
# =============================================================================

# Run intervals (format: 1d, 12h, 6h, 30m, etc.)
FETCH_INTERVAL=12h               # How often to run fetch
PRUNE_INTERVAL=1d                # How often to run prune
FIX_INTERVAL=1d                  # How often to run fix-titles

# Enable/disable daemon tasks
DAEMON_FETCH=1                   # Set to 0 to disable fetch in daemon
DAEMON_PRUNE=1                   # Set to 0 to disable prune in daemon
DAEMON_FIX=1                     # Set to 0 to disable fix-titles in daemon

# =============================================================================
# DOCKER-SPECIFIC SETTINGS
# =============================================================================

# When running in Docker, mount these directories:
# -v /path/to/trailers:/data
# -v /path/to/config:/config

# Example docker-compose.yml environment section:
# environment:
#   - TMDB_API_KEY=your_api_key_here
#   - MODE=theatrical
#   - OUT_DIR=/data/trailers/theatrical
#   - RETENTION_YEARS=2
#   - DEBUG=0
